# ─────────────────────────────────────────────────────────────
# PROJECT ACOM — pinned stack versions
# Single source of truth. Changing a row requires an ADR.
# ─────────────────────────────────────────────────────────────

# ── Upstream baseline ────────────────────────────────────────
# frappe_docker is vendored at this commit (not tracked in this repo).
# Reproduce with:
#   git clone https://github.com/frappe/frappe_docker.git infrastructure/docker/upstream
#   git -C infrastructure/docker/upstream checkout 5a7f074a2bc41dc7db352dc0a87ee4958e86e371
FRAPPE_DOCKER_COMMIT=5a7f074a2bc41dc7db352dc0a87ee4958e86e371

# ── Application versions ─────────────────────────────────────
# ERPNext v16 line chosen over v15: upstream default, and India
# Compliance maintains an active v16 branch (v16.9.1).
#
# NOTE: FRAPPE_BRANCH must be a BRANCH name, not a release tag.
# images/layered/Containerfile uses it for both the base image tag
# (frappe/build:<x>) and `bench init --frappe-branch=<x>`, and base
# images are published per-branch only. A tag there fails with
# "frappe/build:v16.60.2: not found".
FRAPPE_BRANCH=version-16
ERPNEXT_VERSION=v16.60.0
INDIA_COMPLIANCE_VERSION=v16.9.1

# ── Runtime images ───────────────────────────────────────────
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:8.6-alpine
BUILDER_BASE_IMAGE=frappe/build:version-16
RUNTIME_BASE_IMAGE=frappe/base:version-16

# ── Local image tag ──────────────────────────────────────────
# Base Phase 1 image (Frappe + ERPNext + India Compliance).
ACOM_IMAGE=acom/erpnext
ACOM_BASE_IMAGE_TAG=16.60.0-ic16.9.1
# Phase 7 layered image (+ acom_core via Dockerfile.acom).
ACOM_CORE_VERSION=0.5.0
ACOM_IMAGE_TAG=16.60.0-ic16.9.1-acom0.5.0

# ── Site ─────────────────────────────────────────────────────
SITE_NAME=acom.localhost
SITE_TIMEZONE=Asia/Kolkata
SITE_CURRENCY=INR

# ─────────────────────────────────────────────────────────────
# RESOLVED PINS — filled after a successful build.
# The app clones use release tags, so these SHAs are the commit each
# tag pointed to at build time.
#
# NOTE: the runtime image strips .git, so `git -C apps/<app> rev-parse`
# does NOT work inside the container. The SHAs below were captured from
# build-image.log (the `git switch` line emitted during bench init).
# ─────────────────────────────────────────────────────────────
# Captured from build-image.log, 2026-11-20.
RESOLVED_ERPNEXT_SHA=886ab6ae187244e7f1b852393384ab6019d56264
RESOLVED_INDIA_COMPLIANCE_SHA=f309b0e054bc33f459f2bc13e2a1b6787a2b873c
# Frappe floats with the version-16 branch head at build time (ADR-0005),
# so there is no tag SHA to record. Pin by version instead; the immutable
# image digest below is the real reproducibility anchor.
RESOLVED_FRAPPE_VERSION=16.60.2
RESOLVED_FRAPPE_SHA=not-recorded-branch-head-at-build
# Immutable local image identity.
ACOM_BASE_IMAGE_DIGEST=sha256:efe1aec5749648e8d3f3515480c32df4793df1d0a83007c73f9c738a6460d397
ACOM_IMAGE_DIGEST=sha256:cf981364bd8f73c303394df5b8e4f5776523be01862a24073e81c454a824a109
ACOM_IMAGE_SIZE_GB=1.48
BUILD_DATE=2026-11-20
BUILD_DURATION_MIN=27

# Runtime environment observed during build:
#   Python 3.14.10, frappe==16.60.2, erpnext==16.60.0, india-compliance==16.9.1

