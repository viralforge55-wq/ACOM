# ─────────────────────────────────────────────────────────────
# PROJECT ACOM — compose environment template
# Copy to acom.env and fill locally. NEVER commit acom.env.
# Consumed by: docker compose --env-file acom.env
# ─────────────────────────────────────────────────────────────

# ── Image selection ─────────────────────────────────────────
# Point compose at the locally built image instead of pulling.
CUSTOM_IMAGE=acom/erpnext
CUSTOM_TAG=16.60.0-ic16.9.1
PULL_POLICY=missing
ERPNEXT_VERSION=16.60.0

# ── Database ────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
DB_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

# ── Gunicorn (2 workers chosen for a 16 GB host — ADR-0004) ──
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ── Ingress ─────────────────────────────────────────────────
# Only the frontend is published. Backend :8000 and DB :3306
# stay on the private Docker network (security gate G1).
HTTP_PUBLISH_PORT=8080
NGINX_LISTEN_PORT=8080

# Leave empty so nginx resolves the site from the Host header
# (acom.localhost:8080).
FRAPPE_SITE_NAME_HEADER=

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
TRUST_UPSTREAM_FORWARDED_PROTO=off
