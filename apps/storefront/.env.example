# Public storefront origin (safe to expose to browser)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only ERPNext upstream configuration (NEVER prefix with NEXT_PUBLIC_)
# On Windows, Node.js does not resolve *.localhost, so target 127.0.0.1:8080
# and send the Frappe site name via the Host header.
FRAPPE_API_BASE_URL=http://127.0.0.1:8080
FRAPPE_SITE_HOST=acom.localhost
FRAPPE_API_TIMEOUT_MS=8000
