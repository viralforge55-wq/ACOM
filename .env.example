# ─────────────────────────────────────────────────────────────
# PROJECT ACOM — environment template
# Copy to .env and fill locally. NEVER commit the filled file.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
ACOM_SITE_NAME=acom.localhost
ACOM_ENV=development
ACOM_DEFAULT_COMPANY="ACOM Demo Company"
ACOM_DEFAULT_CURRENCY=INR
ACOM_TIMEZONE=Asia/Kolkata

# ── ERPNext / MariaDB (private Docker network only) ──────────
DB_ROOT_PASSWORD=change-me-locally
DB_HOST=mariadb
DB_PORT=3306
MARIADB_IMAGE_TAG=10.6
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# ── Frappe ───────────────────────────────────────────────────
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15
INDIA_COMPLIANCE_BRANCH=version-15

# ── Storefront (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRAPPE_API_BASE_URL=http://localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ── Internal API auth (storefront <-> ERP) ────────────────────
INTERNAL_API_HMAC_SECRET=generate-with-openssl-rand-hex-32
INTERNAL_API_TIMESTAMP_TOLERANCE_SECONDS=300

# ── Payment gateway (TEST MODE ONLY until Phase 5 gate) ──────
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MODE=test

# ── Affiliate networks (Phase 4) ─────────────────────────────
AFFILIATE_AMAZON_TAG=
AFFILIATE_FLIPKART_AFFID=
AFFILIATE_EARNKARMA_TOKEN=

# ── Local AI (Ollama) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:3b-instruct
OLLAMA_MODEL_DEEP=qwen2.5:7b-instruct-q4_K_M
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENT_TASKS=1

# ── Operations ───────────────────────────────────────────────
BACKUP_PATH=backups
LOG_LEVEL=INFO
