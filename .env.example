# ─────────────────────────────────────────────────────────────
# PROJECT ACOM — environment template
# Copy to .env and fill locally. NEVER commit the filled file.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
ACOM_SITE_NAME=acom.localhost
ACOM_ENV=development
ACOM_DEFAULT_COMPANY="ACOM Demo Company"
ACOM_DEFAULT_CURRENCY=INR
ACOM_TIMEZONE=Asia/Kolkata

# ── ERPNext / MariaDB (private Docker network only) ──────────
DB_ROOT_PASSWORD=change-me-locally
DB_HOST=mariadb
DB_PORT=3306
MARIADB_IMAGE_TAG=11.8
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# ── Frappe ───────────────────────────────────────────────────
# Frappe pins by branch, not tag (ADR-0005). ERPNext and India
# Compliance pin by release tag in infrastructure/docker/apps.json.
FRAPPE_BRANCH=version-16
ERPNEXT_VERSION=v16.60.0
INDIA_COMPLIANCE_VERSION=v16.9.1

# ── Storefront (Next.js) ─────────────────────────────────────
# ERPNext is reached through the nginx frontend on 127.0.0.1:8080 with
# explicit Host: acom.localhost (Windows Node.js does not resolve *.localhost).
# Backend :8000 and MariaDB :3306 are never published (gate G1).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
FRAPPE_API_BASE_URL=http://127.0.0.1:8080
FRAPPE_SITE_HOST=acom.localhost
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# ── Internal API auth (storefront <-> ERP) ────────────────────
INTERNAL_API_HMAC_SECRET=generate-with-openssl-rand-hex-32
INTERNAL_API_TIMESTAMP_TOLERANCE_SECONDS=300

# ── Payment gateway (TEST MODE ONLY until Phase 5 gate) ──────
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MODE=test

# ── Affiliate networks (Phase 4) ─────────────────────────────
AFFILIATE_AMAZON_TAG=
AFFILIATE_FLIPKART_AFFID=
AFFILIATE_EARNKARMA_TOKEN=

# ── Local AI (Ollama) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5:3b-instruct
OLLAMA_MODEL_DEEP=qwen2.5:7b-instruct-q4_K_M
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENT_TASKS=1

# ── Operations ───────────────────────────────────────────────
BACKUP_PATH=backups
LOG_LEVEL=INFO
